<div id="couponTableContainer">
    <div class="table-responsive">
        <table class="table table-striped table-hover" id="couponTable">
            <thead class="table-dark">
                <tr>
                    <th scope="col" class="text-center">SI.NO</th>
                    <th scope="col" class="text-center">COUPON CODE</th>
                    <th scope="col" class="text-center">DESCRIPTION</th>
                    <th scope="col" class="text-center">MIN PURCHASE</th>
                    <th scope="col" class="text-center">DISCOUNT TYPE</th>
                    <th scope="col" class="text-center">DISCOUNT VALUE</th>
                    <th scope="col" class="text-center">VALID FROM</th>
                    <th scope="col" class="text-center">VALID TO</th>
                    <th scope="col" class="text-center">STATUS</th>
                    <th scope="col" class="text-center">ACTIONS</th>
                </tr>
            </thead>
            <tbody id="couponTableBody">
                <% coupon.forEach((ele, index) => { %>
                    <tr class="coupon-row" data-index="<%= index %>">
                        <td class="text-center"><%= index + 1 %></td>
                        <td class="text-center"><strong><%= ele.couponCode %></strong></td>
                        <td class="text-center"><%= ele.description || 'No description' %></td>
                        <td class="text-center">₹<%= ele.minimumPurchaseAmount %></td>
                        <td class="text-center">
                            <span class="badge bg-info"><%= ele.discountType %></span>
                        </td>
                        <td class="text-center">
                            <%= ele.discountType === 'Percentage' ? ele.discountValue + '%' : '₹' + ele.discountValue %>
                        </td>
                        <td class="text-center">
                            <%= new Date(ele.validFrom).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </td>
                        <td class="text-center">
                            <%= new Date(ele.validTo).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </td>
                        <td class="text-center">
                            <span class="status-badge status-<%= ele.status.toLowerCase() %>">
                                <%= ele.status %>
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <!-- View button (always enabled) -->
                                <button class="btn btn-sm btn-info me-1 view-coupon-btn" title="View Details" 
                                        data-coupon='<%- JSON.stringify(ele).replace(/'/g, "&apos;").replace(/"/g, "&quot;") %>'>
                                    <i class="bi bi-eye"></i>
                                </button>

                                <!-- Edit button (enabled only if coupon is active and not expired) -->
                                <% if ( ele.status.toLowerCase() !== 'expired') { %>
                                    <button class="btn btn-sm btn-warning me-1 edit-coupon-btn" title="Edit" 
                                            data-coupon='<%- JSON.stringify(ele).replace(/'/g, "&apos;").replace(/"/g, "&quot;") %>'>
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                <% } %>

                                <!-- Delete button (always enabled) -->
                                <button class="btn btn-sm btn-danger delete-coupon-btn" title="Delete" data-coupon-id="<%= ele._id %>">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Custom Pagination -->
    <div class="custom-pagination">
        <div class="pagination-controls">
            <button class="pagination-btn" 
                    data-page="1"
                    <%= currentPage === 1 ? 'disabled' : '' %>>First</button>

            <button class="pagination-btn" 
                    data-page="<%= currentPage - 1 %>"
                    <%= currentPage === 1 ? 'disabled' : '' %>>Previous</button>

            <div id="pageNumbers" class="d-inline-flex gap-1">
                <% for(let i = 1; i <= totalPages; i++){ %>
                    <button class="pagination-btn <%= i === currentPage ? 'active' : '' %>" 
                            data-page="<%= i %>">
                        <%= i %>
                    </button>
                <% } %>
            </div>

            <button class="pagination-btn" 
                    data-page="<%= currentPage + 1 %>"
                    <%= currentPage === totalPages ? 'disabled' : '' %>>Next</button>

            <button class="pagination-btn" 
                    data-page="<%= totalPages %>"
                    <%= currentPage === totalPages ? 'disabled' : '' %>>Last</button>
        </div>

        <div class="pagination-info" id="paginationInfo">
            <% 
                const start = (currentPage - 1) * 8 + 1;
                const end = Math.min(currentPage * 8, totalCoupons);
            %>
            Showing <%= start %> to <%= end %> of <%= totalCoupons %> entries
        </div>
    </div>
</div>

<script>
  // Global handler for pagination buttons
  document.addEventListener("click", function(e) {
    if (e.target.classList.contains("pagination-btn")) {
      const page = e.target.getAttribute("data-page");
      if (page) {
        window.location.href = "?page=" + page;
      }
    }
  });
</script>
