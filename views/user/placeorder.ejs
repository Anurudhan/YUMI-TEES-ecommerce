<%-include("../layout/userheader.ejs")-%>
<link rel="stylesheet" href="/stylesheet/user/placeOrder.css">
<%-include("../layout/usercentre.ejs")-%>

<%-include("../partials/usernavbar.ejs")-%>

<section class="bg-light" style="padding: 60px 0; min-height: 100vh;">
    <div class="container">
        <div class="main-container">
            <div class="row">
                <div class="col-lg-9">
                    <!-- Delivery Address Section -->
                    <div class="section-card">
                        <div class="section-header">
                            <div>
                                <i class="bi bi-geo-alt-fill me-2"></i>
                                Delivery Address
                            </div>
                            <a class="add-address-btn" href="/addaddress?flag=1">
                                <i class="bi bi-plus-circle"></i>
                                Add Address
                            </a>
                        </div>
                        
                        <% if (address != null && address.length > 0) { %>
                            <div id="addressCard0">
                                <div id="existingAddressesContainer">
                                    <!-- First Address -->
                                    <div class="form-check address-card <%= adrsSelect == address[0]._id ? 'selected' : '' %>">
                                        <% if (adrsSelect==null || adrsSelect == undefined ) { %>
                                        <input class="form-check-input" type="radio" name="existingAddress" id="address0" onclick="showButton('deliverHereBtn0')" style="transform: scale(1.2);">
                                        <% } else { %>
                                            <input class="form-check-input" type="radio" name="existingAddress" id="address0" onclick="showButton('deliverHereBtn0')" <%= adrsSelect != address[0]._id ? 'disabled' : '' %> style="transform: scale(1.2);"> 
                                        <% } %>
                                        
                                        <% if (adrsSelect == address[0]._id) { %>
                                            <i class="bi bi-check-circle-fill selected-check"></i>
                                        <% } %>
                                        
                                        <ul class="address-list" style="list-style: none; padding-left: 30px;">
                                            <li class="address-item">
                                                <button type="button" class="address-type-badge">
                                                    <%= address[0].addressType %>
                                                </button>
                                                <h6 style="font-weight: bold; margin: 15px 0 10px;"><%-address[0].name-%></h6>
                                                <p style="color: #666; margin-bottom: 8px;"><%= address[0].address %>, <%= address[0].locality %>, <%= address[0].city %>, <%= address[0].district %>, <%= address[0].state %></p>
                                                <p style="color: #666; margin-bottom: 8px;"><i class="bi bi-telephone me-1"></i><%-address[0].mobile-%></p>
                                                <p style="color: #666; margin-bottom: 20px;"><i class="bi bi-geo-alt me-1"></i><%-address[0].pincode-%></p>
                                                <button type="button" class="deliver-btn d-none" id="deliverHereBtn0" onclick="selectAddress('<%-address[0]._id-%>')">
                                                    <i class="bi bi-truck me-2"></i>Deliver Here
                                                </button>
                                            </li>
                                        </ul>
                                    </div>

                                    <!-- Additional Addresses -->
                                    <% address.forEach(function(data, i) { %>
                                        <% if (i != 0) { %>
                                            <div class="hidden-address form-check address-card <%= adrsSelect == data._id ? 'selected' : '' %>">
                                                <% if (adrsSelect==null || adrsSelect == undefined ) { %>
                                                <input class="form-check-input" type="radio" name="existingAddress" id=<%= "address" + i %> onclick="showButton('<%= "deliverHereBtn" + i %>')" style="transform: scale(1.2);">
                                                <% } else { %>
                                                    <input class="form-check-input" type="radio" name="existingAddress" id=<%= "address" + i %> onclick="showButton('<%= "deliverHereBtn" + i %>')" <%= adrsSelect != data._id ? 'disabled' : '' %> style="transform: scale(1.2);"> 
                                                <% } %>
                                                
                                                <% if (adrsSelect == data._id) { %>
                                                    <i class="bi bi-check-circle-fill selected-check"></i>
                                                <% } %>
                                                
                                                <ul class="address-list" style="list-style: none; padding-left: 30px;">
                                                    <li class="address-item">
                                                        <button type="button" class="address-type-badge"><%= data.addressType %></button>
                                                        <h6 style="font-weight: bold; margin: 15px 0 10px;"><%= data.name %></h6>
                                                        <p style="color: #666; margin-bottom: 8px;"><%= data.address %>, <%= data.locality %>, <%= data.city %>, <%= data.district %>, <%= data.state %></p>
                                                        <p style="color: #666; margin-bottom: 8px;"><i class="bi bi-telephone me-1"></i><%= data.mobile %></p>
                                                        <p style="color: #666; margin-bottom: 20px;"><i class="bi bi-geo-alt me-1"></i><%= data.pincode %></p>
                                                        <button type="button" class="deliver-btn d-none" id=<%= "deliverHereBtn" + i %> onclick="selectAddress('<%-data._id-%>')">
                                                            <i class="bi bi-truck me-2"></i>Deliver Here
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        <% } %>
                                    <% }); %>
                                    
                                    <% if (address.length > 1) { %>
                                        <div class="text-center" style="padding: 25px;">
                                            <a href="#" class="show-all-link" onclick="toggleHiddenAddresses()">
                                                <i class="bi bi-chevron-down me-1"></i>Show All Addresses
                                            </a>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- Payment Options Section -->
                    <div class="section-card">
                        <div class="section-header">
                            <div>
                                <i class="bi bi-credit-card-2-front-fill me-2"></i>
                                Payment Options
                            </div>
                        </div>
                        
                        <div class="payment-options">
                            <label class="payment-card" for="pay-methodoption1">
                                <input type="radio" name="pay-method" id="pay-methodoption1" value="walletPayment" class="d-none">
                                <i class="bi bi-wallet2 payment-icon"></i>
                                <div class="payment-label">Wallet Payment</div>
                            </label>
                            
                            <label class="payment-card" for="pay-methodoption2">
                                <input type="radio" name="pay-method" id="pay-methodoption2" value="OnlinePayment" class="d-none">
                                <img src="assets/razorpay.png" alt="Razorpay Payment" class="razorpay-logo">
                                <div class="payment-label">Razorpay</div>
                            </label>

                            <label class="payment-card" for="pay-methodoption3">
                                <input type="radio" name="pay-method" id="pay-methodoption3" class="d-none" value="cashOnDelivery" checked="">
                                <i class="bi bi-cash-stack payment-icon"></i>
                                <div class="payment-label">Cash on Delivery</div>
                            </label>
                        </div>
                        
                        <% if (grandtotal - disctotal - cpndiscnt > 1000) { %>
                            <div class="alert-custom alert-error">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                Orders above ₹1000 (after discounts) cannot be placed with Cash on Delivery
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Price Details Sidebar -->
                <div class="col-lg-3">
                    <div class="price-card">
                        <!-- Coupon Section -->
                        <div class="coupon-section">
                            <div class="coupon-header">
                                <i class="bi bi-ticket-perforated"></i>
                                HAVE A COUPON?
                            </div>
                            <input type="hidden" id="totalPrice" value="<%= grandtotal %>">
                            <input type="hidden" id="offerDiscount" value="<%= disctotal %>">

                            <% if (couponCount >= 1) { %>
                                <div class="coupon-input-group">
                                    <select class="coupon-select" id="category" name="Category" required>
                                        <option value="" selected disabled>Select a coupon code</option>
                                        <% coupon.forEach((ele) => { %>
                                            <option value="<%= ele.couponCode %>"><%= ele.couponCode %></option>
                                        <% }) %>
                                    </select>
                                    <button type="button" class="coupon-btn apply-button btn-primary">Apply</button>
                                </div>
                                <div class="alert-custom coupon-message alert-success" style="margin-top: 15px; font-size: 0.9rem;">
                                    <i class="bi bi-check-circle"></i>
                                    <%= couponCount %> coupon(s) available for your order
                                </div>
                            <% } else { %>
                                <div class="coupon-input-group">
                                    <select class="coupon-select" disabled>
                                        <option value="">No coupons available</option>
                                    </select>
                                    <button type="button" class="coupon-btn" disabled style="background: #ccc;">Apply</button>
                                </div>
                                <div class="alert-custom alert-warning" style="margin-top: 15px; font-size: 0.9rem;">
                                    <i class="bi bi-info-circle"></i>
                                    No coupons available for your order
                                </div>
                            <% } %>
                        </div>

                        <!-- Price Details -->
                        <div class="price-header">
                            <i class="bi bi-receipt me-2"></i>
                            PRICE DETAILS
                        </div>
                        
                        <div class="price-details">
                            <div class="price-row">
                                <span>Total price:</span>
                                <span id="grandRow">₹ <%= grandtotal %></span>
                            </div>
                            
                            <div class="price-row">
                                <span>Offer Discount:</span>
                                <span id="offerDiscountRow" style="color: #28a745;">-₹ <%= disctotal %></span>
                            </div>
                            
                            <div class="price-row">
                                <span>Coupon Discount:</span>
                                <span id="couponRow" style="color: #28a745;">-₹ <%= cpndiscnt %></span>
                            </div>
                            
                            <div class="price-row">
                                <span>Delivery charges:</span>
                                <span id="deliveryRow">
                                    <% if (grandtotal - disctotal - cpndiscnt < 1000) { %>
                                        +₹ 40
                                    <% } else { %>
                                        <span style="color: #28a745; font-size: 0.9rem;">Free</span>
                                        <del class="text-muted" style="font-size: 0.9rem; margin-left: 5px;">₹ 40</del>
                                    <% } %>
                                </span>
                            </div>
                            
                            <div class="price-row total-row">
                                <span>TOTAL PAYABLE</span>
                                <span id="totalRow">
                                    <% if (grandtotal - disctotal - cpndiscnt < 1000) { %>
                                        ₹ <%= grandtotal  - disctotal - cpndiscnt + 40 %>
                                    <% } else { %>
                                        ₹ <%= grandtotal - disctotal - cpndiscnt %>
                                    <% } %>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="action-row">
                <a href="/" class="continue-shopping">
                    <i class="bi bi-arrow-left"></i>
                    Continue Shopping
                </a>
                <a class="proceed-btn" id="proceedButton">
                    <button type="submit">
                        <i class="bi bi-basket2-fill"></i>
                        Proceed to Checkout
                    </button>
                </a>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
<script>
window.availableCoupons = JSON.parse('<%- JSON.stringify(coupon) %>');
</script>

<script src="/javascript/user/placeorder.js"></script>

<%-include("../layout/userfooter.ejs")-%>